pipeline {
    agent any 

   // tools {
   //     maven 'Maven3'
   //     jdk 'JDK-21'
   //}

    environment {
        SONARQUBE_TOKEN = credentials('jenkins2sonarqube')   // Jenkins credential ID for your SonarQube token
        SONARQUBE_SERVER = 'http://localhost:9000'
        SONARQUBE_PROJECT_KEY = 'Java4Sonar-Project'
    }

    stages {
        stage('validation') {
            steps {
                echo "Checking for 'pom.xml' file for Maven project"
                bat 'mvn validate'
            }
        }

        stage('build') {
            steps {
                echo "Making build for maven project"
                bat 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(installationName: 'SonarQube') {
                    echo "Running SonarQube analysis..."
                    bat '''
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=%SONARQUBE_PROJECT_KEY% ^
                        -Dsonar.host.url=%SONARQUBE_SERVER% ^
                        -Dsonar.login=%SONARQUBE_TOKEN%
                    '''
                }
            }
        }

        stage('Check Quality Gate via API') {
            steps {
                script {
                    echo "Waiting for SonarQube analysis to complete..."
                    
                    // Polling loop to wait for analysis completion
                    timeout(time: 10, unit: 'MINUTES') {
                        def status = ''
                        while (status == '' || status == 'PENDING') {
                            sleep(time: 10, unit: 'SECONDS')  // wait 10 seconds before retry
                            def response = bat(
                                script: """
                                    curl -s -u %SONARQUBE_TOKEN%: ^
                                    "%SONARQUBE_SERVER%/api/qualitygates/project_status?projectKey=%SONARQUBE_PROJECT_KEY%"
                                """, 
                                returnStdout: true
                            ).trim()
                            
                            def json = readJSON text: response
                            status = json.projectStatus.status
                            echo "Current Quality Gate status: ${status}"
                        }
                        
                        if (status != 'OK') {
                            error "Quality Gate failed with status: ${status}"
                        } else {
                            echo "Quality Gate passed! Ready for deployment."
                        }
                    }
                }
            }
        }

        stage('deploy') {
          //  when {
          //      expression {
          //          return currentBuild.result == null || currentBuild.result == 'SUCCESS'
          //      }
          //  }
            steps {
                echo "Triggering Deployment pipeline..."
                // Add your deployment steps here
            }
        }
    }

      //  stage('execute') {
      //      steps {
      //          echo "Executing the build to get the output for maven project"
      //          bat 'java -jar target/MavenProject-0.0.1-SNAPSHOT.jar'
      //      }
      //  }

    post {
       success {
           echo 'Pipeline executed Successfully!'
       }
       failure {
           echo 'Pipeline execution Failed!'
       }
   }
}

